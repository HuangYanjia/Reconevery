{
  "$defs": {
    "BundleObjectAssemblyDecision": {
      "additionalProperties": false,
      "properties": {
        "articulated_model_source": {
          "anyOf": [
            {
              "$ref": "#/$defs/SceneAssemblySourceReference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rationale": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Rationale",
          "type": "array"
        },
        "selected_candidate_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selected Candidate Id"
        },
        "selected_visual_asset_ids": {
          "items": {
            "type": "string"
          },
          "title": "Selected Visual Asset Ids",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/ObjectAssemblyDecisionStatus"
        }
      },
      "required": [
        "status",
        "rationale"
      ],
      "title": "BundleObjectAssemblyDecision",
      "type": "object"
    },
    "GeometrySourceType": {
      "enum": [
        "measured",
        "radiance_field",
        "generated",
        "retrieved",
        "fused",
        "mock"
      ],
      "title": "GeometrySourceType",
      "type": "string"
    },
    "ObjectAssemblyDecisionSet": {
      "additionalProperties": false,
      "properties": {
        "deployment_decision": {
          "$ref": "#/$defs/BundleObjectAssemblyDecision"
        },
        "measured_anchor_asset_ids": {
          "items": {
            "type": "string"
          },
          "title": "Measured Anchor Asset Ids",
          "type": "array"
        },
        "measured_motion": {
          "anyOf": [
            {
              "$ref": "#/$defs/SceneAssemblySourceReference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "object_id": {
          "minLength": 1,
          "title": "Object Id",
          "type": "string"
        },
        "research_decision": {
          "$ref": "#/$defs/BundleObjectAssemblyDecision"
        }
      },
      "required": [
        "object_id",
        "measured_anchor_asset_ids",
        "research_decision",
        "deployment_decision"
      ],
      "title": "ObjectAssemblyDecisionSet",
      "type": "object"
    },
    "ObjectAssemblyDecisionStatus": {
      "enum": [
        "selected_deployment_candidate",
        "selected_research_candidate",
        "measured_only",
        "global_context_only",
        "deferred_no_valid_candidate",
        "deferred_license_blocked",
        "deferred_articulated_unresolved",
        "ignored"
      ],
      "title": "ObjectAssemblyDecisionStatus",
      "type": "string"
    },
    "PlannedAssemblyAsset": {
      "additionalProperties": false,
      "properties": {
        "asset": {
          "$ref": "#/$defs/SceneAssemblyAssetRecord"
        },
        "asset_to_assembly_world": {
          "items": {
            "type": "number"
          },
          "maxItems": 16,
          "minItems": 16,
          "title": "Asset To Assembly World",
          "type": "array"
        },
        "exclusion_reasons": {
          "items": {
            "type": "string"
          },
          "title": "Exclusion Reasons",
          "type": "array"
        },
        "included_in_deployment": {
          "title": "Included In Deployment",
          "type": "boolean"
        },
        "included_in_research": {
          "title": "Included In Research",
          "type": "boolean"
        }
      },
      "required": [
        "asset",
        "asset_to_assembly_world",
        "included_in_research",
        "included_in_deployment"
      ],
      "title": "PlannedAssemblyAsset",
      "type": "object"
    },
    "SceneAssemblyArtifactReference": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "SceneAssemblyArtifactReference",
      "type": "object"
    },
    "SceneAssemblyAssetRecord": {
      "additionalProperties": false,
      "properties": {
        "articulation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Articulation Id"
        },
        "asset_id": {
          "minLength": 1,
          "title": "Asset Id",
          "type": "string"
        },
        "asset_native_space": {
          "$ref": "#/$defs/SceneAssemblyAssetSpace"
        },
        "asset_path": {
          "title": "Asset Path",
          "type": "string"
        },
        "asset_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Asset Sha256",
          "type": "string"
        },
        "asset_to_object": {
          "items": {
            "type": "number"
          },
          "maxItems": 16,
          "minItems": 16,
          "title": "Asset To Object",
          "type": "array"
        },
        "bounds_native": {
          "anyOf": [
            {
              "maxItems": 6,
              "minItems": 6,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bounds Native"
        },
        "candidate_evaluation": {
          "anyOf": [
            {
              "$ref": "#/$defs/SceneAssemblySourceReference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "candidate_generation": {
          "anyOf": [
            {
              "$ref": "#/$defs/SceneAssemblySourceReference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "candidate_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidate Id"
        },
        "candidate_selection": {
          "anyOf": [
            {
              "$ref": "#/$defs/SceneAssemblySourceReference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "collision_ready": {
          "const": false,
          "default": false,
          "title": "Collision Ready",
          "type": "boolean"
        },
        "format": {
          "enum": [
            "obj",
            "glb",
            "ply"
          ],
          "title": "Format",
          "type": "string"
        },
        "kinematic_bundle": {
          "anyOf": [
            {
              "$ref": "#/$defs/SceneAssemblySourceReference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "license": {
          "$ref": "#/$defs/SceneAssemblyLicenseRecord"
        },
        "license_source_record": {
          "anyOf": [
            {
              "$ref": "#/$defs/SceneAssemblySourceReference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "lineage_id": {
          "minLength": 1,
          "title": "Lineage Id",
          "type": "string"
        },
        "link_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Link Id"
        },
        "measured_geometry": {
          "anyOf": [
            {
              "$ref": "#/$defs/SceneAssemblySourceReference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "object_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Object Id"
        },
        "object_to_source_world": {
          "items": {
            "type": "number"
          },
          "maxItems": 16,
          "minItems": 16,
          "title": "Object To Source World",
          "type": "array"
        },
        "observation_validation_passed": {
          "default": false,
          "title": "Observation Validation Passed",
          "type": "boolean"
        },
        "part_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Part Id"
        },
        "physical_validation": {
          "const": "not_implemented",
          "default": "not_implemented",
          "title": "Physical Validation",
          "type": "string"
        },
        "representation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Representation Id"
        },
        "role": {
          "$ref": "#/$defs/SceneAssemblyAssetRole"
        },
        "selected_upstream": {
          "default": false,
          "title": "Selected Upstream",
          "type": "boolean"
        },
        "sim_ready": {
          "const": false,
          "default": false,
          "title": "Sim Ready",
          "type": "boolean"
        },
        "source": {
          "$ref": "#/$defs/GeometrySourceType"
        },
        "source_asset_immutable": {
          "const": true,
          "default": true,
          "title": "Source Asset Immutable",
          "type": "boolean"
        },
        "source_native_asset_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Native Asset Path"
        },
        "visual_only": {
          "const": true,
          "default": true,
          "title": "Visual Only",
          "type": "boolean"
        }
      },
      "required": [
        "asset_id",
        "lineage_id",
        "role",
        "source",
        "asset_path",
        "asset_sha256",
        "format",
        "asset_native_space",
        "asset_to_object",
        "object_to_source_world",
        "license"
      ],
      "title": "SceneAssemblyAssetRecord",
      "type": "object"
    },
    "SceneAssemblyAssetRole": {
      "enum": [
        "measured_anchor",
        "visual_completion",
        "global_context",
        "articulated_visual",
        "diagnostic"
      ],
      "title": "SceneAssemblyAssetRole",
      "type": "string"
    },
    "SceneAssemblyAssetSpace": {
      "enum": [
        "reference_world",
        "candidate_base",
        "link_local",
        "global_context"
      ],
      "title": "SceneAssemblyAssetSpace",
      "type": "string"
    },
    "SceneAssemblyCalibrationPolicy": {
      "enum": [
        "use_full_canonical_if_available",
        "require_full_canonical",
        "preserve_source_world"
      ],
      "title": "SceneAssemblyCalibrationPolicy",
      "type": "string"
    },
    "SceneAssemblyLayer": {
      "additionalProperties": false,
      "properties": {
        "asset_ids": {
          "items": {
            "type": "string"
          },
          "title": "Asset Ids",
          "type": "array"
        },
        "included_in_deployment": {
          "title": "Included In Deployment",
          "type": "boolean"
        },
        "included_in_research": {
          "title": "Included In Research",
          "type": "boolean"
        },
        "layer_id": {
          "minLength": 1,
          "title": "Layer Id",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/SceneAssemblyAssetRole"
        }
      },
      "required": [
        "layer_id",
        "role",
        "asset_ids",
        "included_in_research",
        "included_in_deployment"
      ],
      "title": "SceneAssemblyLayer",
      "type": "object"
    },
    "SceneAssemblyLicenseRecord": {
      "additionalProperties": false,
      "properties": {
        "commercial_review_status": {
          "enum": [
            "approved",
            "not_reviewed",
            "research_only",
            "blocked"
          ],
          "title": "Commercial Review Status",
          "type": "string"
        },
        "license_id": {
          "minLength": 1,
          "title": "License Id",
          "type": "string"
        },
        "license_name": {
          "minLength": 1,
          "title": "License Name",
          "type": "string"
        },
        "production_selectable": {
          "title": "Production Selectable",
          "type": "boolean"
        },
        "research_evaluation_allowed": {
          "title": "Research Evaluation Allowed",
          "type": "boolean"
        },
        "restrictions": {
          "items": {
            "type": "string"
          },
          "title": "Restrictions",
          "type": "array"
        },
        "source_record": {
          "anyOf": [
            {
              "$ref": "#/$defs/SceneAssemblySourceReference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "license_id",
        "license_name",
        "research_evaluation_allowed",
        "production_selectable",
        "commercial_review_status"
      ],
      "title": "SceneAssemblyLicenseRecord",
      "type": "object"
    },
    "SceneAssemblySourceArtifactType": {
      "enum": [
        "camera_reconstruction",
        "source_scene_ir",
        "measured_geometry",
        "rigid_selection",
        "rigid_evaluation",
        "rigid_registration",
        "rigid_generation",
        "representation_parity",
        "articulated_selection",
        "articulated_candidate_manifest",
        "articulated_evaluation",
        "articulated_fitting",
        "articulated_link_assignment",
        "selected_identity_manifest",
        "kinematic_bundle",
        "license_record",
        "world_calibration",
        "canonical_wrapper",
        "state_alignment",
        "measured_motion",
        "global_context_manifest"
      ],
      "title": "SceneAssemblySourceArtifactType",
      "type": "string"
    },
    "SceneAssemblySourceReference": {
      "additionalProperties": false,
      "properties": {
        "artifact_type": {
          "$ref": "#/$defs/SceneAssemblySourceArtifactType"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256",
        "artifact_type"
      ],
      "title": "SceneAssemblySourceReference",
      "type": "object"
    },
    "SceneAssemblyWorldMode": {
      "enum": [
        "source_arbitrary",
        "canonical_metric",
        "metric_unoriented",
        "gravity_aligned_arbitrary_scale"
      ],
      "title": "SceneAssemblyWorldMode",
      "type": "string"
    },
    "SceneAssemblyWorldRecord": {
      "additionalProperties": false,
      "properties": {
        "alignment_status": {
          "enum": [
            "canonical",
            "gravity_aligned",
            "unoriented"
          ],
          "title": "Alignment Status",
          "type": "string"
        },
        "calibration_policy": {
          "$ref": "#/$defs/SceneAssemblyCalibrationPolicy"
        },
        "calibration_status": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorldCalibrationStatus"
            },
            {
              "type": "null"
            }
          ]
        },
        "full_canonical_world_used": {
          "title": "Full Canonical World Used",
          "type": "boolean"
        },
        "gravity_alignment_known": {
          "title": "Gravity Alignment Known",
          "type": "boolean"
        },
        "linear_units": {
          "enum": [
            "meters",
            "arbitrary_units"
          ],
          "title": "Linear Units",
          "type": "string"
        },
        "metric_scale_known": {
          "title": "Metric Scale Known",
          "type": "boolean"
        },
        "source_world_to_assembly_world": {
          "items": {
            "type": "number"
          },
          "maxItems": 16,
          "minItems": 16,
          "title": "Source World To Assembly World",
          "type": "array"
        },
        "world_mode": {
          "$ref": "#/$defs/SceneAssemblyWorldMode"
        },
        "world_wrapper_required": {
          "title": "World Wrapper Required",
          "type": "boolean"
        }
      },
      "required": [
        "world_mode",
        "calibration_policy",
        "calibration_status",
        "source_world_to_assembly_world",
        "linear_units",
        "alignment_status",
        "full_canonical_world_used",
        "metric_scale_known",
        "gravity_alignment_known",
        "world_wrapper_required"
      ],
      "title": "SceneAssemblyWorldRecord",
      "type": "object"
    },
    "WorldCalibrationStatus": {
      "enum": [
        "accepted_full_canonical",
        "accepted_metric_only",
        "accepted_gravity_only",
        "rejected_inconsistent_metric_evidence",
        "rejected_inconsistent_gravity_evidence",
        "rejected_heldout_validation",
        "insufficient_forward_evidence",
        "insufficient_origin_evidence",
        "insufficient_evidence"
      ],
      "title": "WorldCalibrationStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assets": {
      "items": {
        "$ref": "#/$defs/PlannedAssemblyAsset"
      },
      "title": "Assets",
      "type": "array"
    },
    "background_hole_filling": {
      "const": false,
      "default": false,
      "title": "Background Hole Filling",
      "type": "boolean"
    },
    "decisions": {
      "items": {
        "$ref": "#/$defs/ObjectAssemblyDecisionSet"
      },
      "title": "Decisions",
      "type": "array"
    },
    "destructive_object_removal": {
      "const": false,
      "default": false,
      "title": "Destructive Object Removal",
      "type": "boolean"
    },
    "deterministic_plan_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Deterministic Plan Digest",
      "type": "string"
    },
    "global_scene_policy": {
      "const": "layered_no_carve_v1",
      "default": "layered_no_carve_v1",
      "title": "Global Scene Policy",
      "type": "string"
    },
    "input_manifest": {
      "$ref": "#/$defs/SceneAssemblyArtifactReference"
    },
    "layers": {
      "items": {
        "$ref": "#/$defs/SceneAssemblyLayer"
      },
      "title": "Layers",
      "type": "array"
    },
    "lineage_report": {
      "$ref": "#/$defs/SceneAssemblyArtifactReference"
    },
    "schema_version": {
      "const": "0.2.0",
      "default": "0.2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_geometry_immutable": {
      "const": true,
      "default": true,
      "title": "Source Geometry Immutable",
      "type": "boolean"
    },
    "world": {
      "$ref": "#/$defs/SceneAssemblyWorldRecord"
    }
  },
  "required": [
    "input_manifest",
    "world",
    "lineage_report",
    "decisions",
    "assets",
    "layers",
    "deterministic_plan_digest"
  ],
  "title": "SceneAssemblyPlan",
  "type": "object"
}
