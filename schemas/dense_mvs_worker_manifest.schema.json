  "required": [
    "worker_version",
    "official_colmap_repository",
    "official_colmap_version",
    "official_colmap_commit",
    "colmap_license",
    "build_configuration",
    "request_sha256",
    "manifest_sha256",
    "frame_sequence_digest",
    "camera_reconstruction_sha256",
    "registered_frame_ids",
    "command_arguments",
    "return_codes",
    "runtime_seconds",
    "raw_output_paths"
  ],
  "title": "DenseMVSWorkerManifest",
  "type": "object"
}
