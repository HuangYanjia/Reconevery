{
  "$defs": {
    "AlignmentStatus": {
      "enum": [
        "canonical",
        "gravity_aligned",
        "unoriented"
      ],
      "title": "AlignmentStatus",
      "type": "string"
    },
    "CameraAxes": {
      "enum": [
        "unspecified",
        "x_right_y_down_z_forward"
      ],
      "title": "CameraAxes",
      "type": "string"
    },
    "CoordinateConvention": {
      "additionalProperties": false,
      "properties": {
        "alignment_status": {
          "$ref": "#/$defs/AlignmentStatus",
          "default": "canonical"
        },
        "camera_axes": {
          "$ref": "#/$defs/CameraAxes",
          "default": "unspecified"
        },
        "handedness": {
          "const": "right",
          "default": "right",
          "title": "Handedness",
          "type": "string"
        },
        "linear_units": {
          "$ref": "#/$defs/LinearUnits",
          "default": "meters"
        },
        "quaternion_order": {
          "const": "xyzw",
          "default": "xyzw",
          "title": "Quaternion Order",
          "type": "string"
        },
        "scale_status": {
          "$ref": "#/$defs/ScaleStatus",
          "default": "metric_scale_known"
        },
        "transform_direction": {
          "$ref": "#/$defs/TransformDirection",
          "default": "world_from_camera"
        },
        "world_frame": {
          "$ref": "#/$defs/WorldFrame",
          "default": "canonical_x_forward_y_left_z_up"
        }
      },
      "title": "CoordinateConvention",
      "type": "object"
    },
    "LinearUnits": {
      "enum": [
        "meters",
        "arbitrary_units"
      ],
      "title": "LinearUnits",
      "type": "string"
    },
    "ScaleStatus": {
      "enum": [
        "metric_scale_known",
        "scale_ambiguous",
        "externally_scaled"
      ],
      "title": "ScaleStatus",
      "type": "string"
    },
    "TransformDirection": {
      "enum": [
        "world_from_camera"
      ],
      "title": "TransformDirection",
      "type": "string"
    },
    "WorldFrame": {
      "enum": [
        "canonical_x_forward_y_left_z_up",
        "colmap_arbitrary"
      ],
      "title": "WorldFrame",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "bounds_max": {
      "maxItems": 3,
      "minItems": 3,
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "title": "Bounds Max",
      "type": "array"
    },
    "bounds_min": {
      "maxItems": 3,
      "minItems": 3,
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "title": "Bounds Min",
      "type": "array"
    },
    "coordinate_convention": {
      "$ref": "#/$defs/CoordinateConvention"
    },
    "fused_point_cloud_path": {
      "const": "reconstruction/dense/fused.ply",
      "title": "Fused Point Cloud Path",
      "type": "string"
    },
    "fused_point_cloud_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Fused Point Cloud Sha256",
      "type": "string"
    },
    "normal_count": {
      "minimum": 0,
      "title": "Normal Count",
      "type": "integer"
    },
    "point_count": {
      "exclusiveMinimum": 0,
      "title": "Point Count",
      "type": "integer"
    },
    "scale_status": {
      "$ref": "#/$defs/ScaleStatus"
    },
    "scene_diagonal_arbitrary_units": {
      "exclusiveMinimum": 0,
      "title": "Scene Diagonal Arbitrary Units",
      "type": "number"
    },
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "fused_point_cloud_path",
    "fused_point_cloud_sha256",
    "point_count",
    "normal_count",
    "bounds_min",
    "bounds_max",
    "scene_diagonal_arbitrary_units",
    "coordinate_convention",
    "scale_status"
  ],
  "title": "DenseFusionArtifact",
  "type": "object"
}
