{
  "$defs": {
    "AlignmentStatus": {
      "enum": [
        "canonical",
        "gravity_aligned",
        "unoriented"
      ],
      "title": "AlignmentStatus",
      "type": "string"
    },
    "ArticulatedPartStateGeometry": {
      "additionalProperties": false,
      "properties": {
        "articulated_object_id": {
          "minLength": 1,
          "title": "Articulated Object Id",
          "type": "string"
        },
        "coordinate_convention": {
          "$ref": "#/$defs/CoordinateConvention"
        },
        "mask_paths": {
          "items": {
            "type": "string"
          },
          "title": "Mask Paths",
          "type": "array"
        },
        "measured_point_cloud_path": {
          "title": "Measured Point Cloud Path",
          "type": "string"
        },
        "measured_point_cloud_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Measured Point Cloud Sha256",
          "type": "string"
        },
        "measured_surfel_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Measured Surfel Path"
        },
        "measured_surfel_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Measured Surfel Sha256"
        },
        "normal_count": {
          "minimum": 0,
          "title": "Normal Count",
          "type": "integer"
        },
        "part_id": {
          "minLength": 1,
          "title": "Part Id",
          "type": "string"
        },
        "point_count": {
          "minimum": 0,
          "title": "Point Count",
          "type": "integer"
        },
        "prompt_id": {
          "minLength": 1,
          "title": "Prompt Id",
          "type": "string"
        },
        "scale_status": {
          "$ref": "#/$defs/ScaleStatus"
        },
        "semantic_label": {
          "minLength": 1,
          "title": "Semantic Label",
          "type": "string"
        },
        "source_track_id": {
          "minLength": 1,
          "title": "Source Track Id",
          "type": "string"
        },
        "state_alignment_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "State Alignment Sha256",
          "type": "string"
        },
        "state_id": {
          "minLength": 1,
          "title": "State Id",
          "type": "string"
        },
        "supporting_frame_ids": {
          "items": {
            "type": "string"
          },
          "title": "Supporting Frame Ids",
          "type": "array"
        },
        "transformed_to_reference_frame": {
          "title": "Transformed To Reference Frame",
          "type": "boolean"
        }
      },
      "required": [
        "state_id",
        "articulated_object_id",
        "part_id",
        "source_track_id",
        "prompt_id",
        "semantic_label",
        "measured_point_cloud_path",
        "measured_point_cloud_sha256",
        "point_count",
        "normal_count",
        "supporting_frame_ids",
        "mask_paths",
        "state_alignment_sha256",
        "transformed_to_reference_frame",
        "coordinate_convention",
        "scale_status"
      ],
      "title": "ArticulatedPartStateGeometry",
      "type": "object"
    },
    "CameraAxes": {
      "enum": [
        "unspecified",
        "x_right_y_down_z_forward"
      ],
      "title": "CameraAxes",
      "type": "string"
    },
    "CoordinateConvention": {
      "additionalProperties": false,
      "properties": {
        "alignment_status": {
          "$ref": "#/$defs/AlignmentStatus",
          "default": "canonical"
        },
        "camera_axes": {
          "$ref": "#/$defs/CameraAxes",
          "default": "unspecified"
        },
        "handedness": {
          "const": "right",
          "default": "right",
          "title": "Handedness",
          "type": "string"
        },
        "linear_units": {
          "$ref": "#/$defs/LinearUnits",
          "default": "meters"
        },
        "quaternion_order": {
          "const": "xyzw",
          "default": "xyzw",
          "title": "Quaternion Order",
          "type": "string"
        },
        "scale_status": {
          "$ref": "#/$defs/ScaleStatus",
          "default": "metric_scale_known"
        },
        "transform_direction": {
          "$ref": "#/$defs/TransformDirection",
          "default": "world_from_camera"
        },
        "world_frame": {
          "$ref": "#/$defs/WorldFrame",
          "default": "canonical_x_forward_y_left_z_up"
        }
      },
      "title": "CoordinateConvention",
      "type": "object"
    },
    "LinearUnits": {
      "enum": [
        "meters",
        "arbitrary_units"
      ],
      "title": "LinearUnits",
      "type": "string"
    },
    "ScaleStatus": {
      "enum": [
        "metric_scale_known",
        "scale_ambiguous",
        "externally_scaled"
      ],
      "title": "ScaleStatus",
      "type": "string"
    },
    "TransformDirection": {
      "enum": [
        "world_from_camera"
      ],
      "title": "TransformDirection",
      "type": "string"
    },
    "WorldFrame": {
      "enum": [
        "canonical_x_forward_y_left_z_up",
        "colmap_arbitrary"
      ],
      "title": "WorldFrame",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "capture_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Capture Manifest Sha256",
      "type": "string"
    },
    "geometries": {
      "items": {
        "$ref": "#/$defs/ArticulatedPartStateGeometry"
      },
      "title": "Geometries",
      "type": "array"
    },
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "capture_manifest_sha256",
    "geometries"
  ],
  "title": "ArticulatedPartStateGeometryManifest",
  "type": "object"
}
