{
  "$defs": {
    "AssetType": {
      "enum": [
        "unclassified",
        "static_structure",
        "rigid",
        "articulated",
        "deformable",
        "fluid_or_particle",
        "ignore"
      ],
      "title": "AssetType",
      "type": "string"
    },
    "SegmentationPoint": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "enum": [
            0,
            1
          ],
          "title": "Label",
          "type": "integer"
        },
        "x": {
          "minimum": 0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "minimum": 0,
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "label"
      ],
      "title": "SegmentationPoint",
      "type": "object"
    },
    "SegmentationPrompt": {
      "additionalProperties": false,
      "properties": {
        "asset_type_hint": {
          "anyOf": [
            {
              "$ref": "#/$defs/AssetType"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "box_xyxy": {
          "anyOf": [
            {
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Box Xyxy"
        },
        "confidence_threshold": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence Threshold"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "frame_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frame Id"
        },
        "instance_limit": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Instance Limit"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "mask_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mask Path"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "points": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/SegmentationPoint"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Points"
        },
        "positive": {
          "default": true,
          "title": "Positive",
          "type": "boolean"
        },
        "prompt_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Prompt Id",
          "type": "string"
        },
        "prompt_type": {
          "anyOf": [
            {
              "$ref": "#/$defs/SegmentationPromptType"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "synonym_group": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Synonym Group"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        }
      },
      "required": [
        "prompt_id",
        "label"
      ],
      "title": "SegmentationPrompt",
      "type": "object"
    },
    "SegmentationPromptType": {
      "enum": [
        "text",
        "box",
        "point",
        "mask"
      ],
      "title": "SegmentationPromptType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "input_hashes": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Input Hashes",
      "type": "object"
    },
    "prompts": {
      "items": {
        "$ref": "#/$defs/SegmentationPrompt"
      },
      "title": "Prompts",
      "type": "array"
    },
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Path"
    },
    "source_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Sha256"
    }
  },
  "required": [
    "prompts"
  ],
  "title": "SegmentationPromptManifest",
  "type": "object"
}
