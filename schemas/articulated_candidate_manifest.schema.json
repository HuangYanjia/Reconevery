        "configuration": {
          "additionalProperties": true,
          "title": "Configuration",
          "type": "object"
        },
        "input_artifact_paths": {
          "items": {
            "type": "string"
          },
          "title": "Input Artifact Paths",
          "type": "array"
        },
        "output_artifact_paths": {
          "items": {
            "type": "string"
          },
          "title": "Output Artifact Paths",
          "type": "array"
        },
        "source": {
          "$ref": "#/$defs/GeometrySourceType"
