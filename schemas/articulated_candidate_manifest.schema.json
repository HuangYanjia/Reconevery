      "title": "Candidates",
      "type": "array"
    },
    "failed_candidate_ids": {
      "items": {
        "type": "string"
      },
      "title": "Failed Candidate Ids",
      "type": "array"
    },
    "measured_motion_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Measured Motion Sha256",
      "type": "string"
    },
    "retrieval_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Retrieval Manifest Sha256",
      "type": "string"
    },
    "runtime_seconds": {
      "minimum": 0,
      "title": "Runtime Seconds",
      "type": "number"
    },
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    },
    "worker_manifests": {
      "items": {
        "$ref": "#/$defs/ParticulateWorkerManifest"
      },
      "title": "Worker Manifests",
      "type": "array"
    }
  },
  "required": [
    "measured_motion_sha256",
    "retrieval_manifest_sha256",
    "candidates",
    "runtime_seconds"
  ],
  "title": "ArticulatedCandidateManifest",
  "type": "object"
}
