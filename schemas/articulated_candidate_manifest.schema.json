    "ParticulateWorkerManifest": {
      "additionalProperties": false,
      "properties": {
        "checkpoint_hashes": {
          "additionalProperties": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Checkpoint Hashes",
          "type": "object"
