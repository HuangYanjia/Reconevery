        "checkpoint_repository": {
          "const": "rayli/Particulate",
          "title": "Checkpoint Repository",
          "type": "string"
        },
        "checkpoint_revision": {
          "const": "096167e661feb92a443535d15916323ec8a01613",
          "title": "Checkpoint Revision",
          "type": "string"
        },
        "official_code_commit": {
          "const": "dee37a75c449f324d9989993461ee09eaccc1686",
          "title": "Official Code Commit",
          "type": "string"
        },
        "official_repository": {
          "const": "https://github.com/RuiningLi/particulate",
          "title": "Official Repository",
          "type": "string"
        },
        "peak_gpu_memory_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
