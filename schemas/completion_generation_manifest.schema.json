          "title": "Supports Depth",
          "type": "boolean"
        },
        "supports_normals": {
          "default": false,
          "title": "Supports Normals",
          "type": "boolean"
        },
        "supports_rgba": {
          "title": "Supports Rgba",
          "type": "boolean"
