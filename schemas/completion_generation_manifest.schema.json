          "title": "Normalized Intrinsics",
          "type": "array"
        },
        "pixel_intrinsics": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Pixel Intrinsics",
          "type": "array"
