        "dependency_licenses": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Dependency Licenses",
          "type": "object"
        },
        "production_selectable": {
          "title": "Production Selectable",
          "type": "boolean"
        },
        "research_evaluation_allowed": {
          "title": "Research Evaluation Allowed",
          "type": "boolean"
        }
      },
      "required": [
        "backend",
        "code_license",
        "checkpoint_license",
        "asset_license",
        "commercial_use_review_status",
        "research_evaluation_allowed",
        "production_selectable"
      ],
      "title": "CompletionLicenseRecord",
      "type": "object"
    },
    "ConfidenceRecord": {
      "additionalProperties": false,
      "properties": {
        "method": {
          "minLength": 1,
          "title": "Method",
          "type": "string"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
