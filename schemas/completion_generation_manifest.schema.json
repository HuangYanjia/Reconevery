    "CompletionBackend": {
      "enum": [
        "sam3d_objects",
        "trellis2",
        "measured_partial_baseline"
      ],
      "title": "CompletionBackend",
      "type": "string"
    },
    "CompletionEligibilityStatus": {
      "enum": [
        "eligible_rigid",
        "eligible_static",
        "deferred_articulated",
        "deferred_deformable",
        "deferred_fluid",
        "deferred_human",
        "deferred_unknown"
