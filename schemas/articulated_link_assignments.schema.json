{
  "$defs": {
    "ArticulatedLinkAssignment": {
      "additionalProperties": false,
      "properties": {
        "assignments": {
          "items": {
            "$ref": "#/$defs/ArticulatedLinkAssignmentRecord"
          },
          "title": "Assignments",
          "type": "array"
        },
        "candidate_id": {
          "minLength": 1,
          "title": "Candidate Id",
          "type": "string"
        },
        "schema_version": {
          "const": "0.1.0",
          "default": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "unmatched_candidate_links": {
          "items": {
            "type": "string"
          },
          "title": "Unmatched Candidate Links",
          "type": "array"
        },
        "unmatched_observed_parts": {
          "items": {
            "type": "string"
          },
          "title": "Unmatched Observed Parts",
          "type": "array"
        }
      },
      "required": [
        "candidate_id",
        "assignments",
        "unmatched_candidate_links",
        "unmatched_observed_parts"
      ],
      "title": "ArticulatedLinkAssignment",
      "type": "object"
    },
    "ArticulatedLinkAssignmentRecord": {
      "additionalProperties": false,
      "properties": {
        "ambiguous": {
          "default": false,
          "title": "Ambiguous",
          "type": "boolean"
        },
        "assignment_confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Assignment Confidence",
          "type": "number"
        },
        "candidate_link_ids": {
          "items": {
            "type": "string"
          },
          "title": "Candidate Link Ids",
          "type": "array"
        },
        "evidence": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Evidence",
          "type": "object"
        },
        "observed_part_id": {
          "minLength": 1,
          "title": "Observed Part Id",
          "type": "string"
        }
      },
      "required": [
        "observed_part_id",
        "candidate_link_ids",
        "assignment_confidence",
        "evidence"
      ],
      "title": "ArticulatedLinkAssignmentRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assignments": {
      "items": {
        "$ref": "#/$defs/ArticulatedLinkAssignment"
      },
      "title": "Assignments",
      "type": "array"
    },
    "candidate_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Candidate Manifest Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "candidate_manifest_sha256",
    "assignments"
  ],
  "title": "ArticulatedLinkAssignmentManifest",
  "type": "object"
}
